# Copy to .env (git-ignored) to send Pulsewatch alerts to Telegram from docker compose.
# Leave both empty to keep alerts in the local alert sink only (http://localhost:9095/notifications).
# Bot token: talk to @BotFather. Chat id: message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id":...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
