{
  "uid": "pulsewatch-overview",
  "title": "Pulsewatch overview",
  "description": "Uptime and latency for every Pulsewatch target, per probe region.",
  "tags": [
    "pulsewatch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsewatch-prometheus"
        },
        "query": {
          "query": "label_values(pulsewatch_up, region)",
          "refId": "region-var"
        },
        "definition": "label_values(pulsewatch_up, region)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pulsewatch-prometheus"
        },
        "query": {
          "query": "label_values(pulsewatch_up{region=~\"$region\"}, target)",
          "refId": "target-var"
        },
        "definition": "label_values(pulsewatch_up{region=~\"$region\"}, target)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets up (all regions)",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "count(min by (target) (pulsewatch_up{region=~\"$region\", target=~\"$target\"}) == 1) or vector(0)",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Targets that are up from every selected region."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets down (any region)",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "count(min by (target) (pulsewatch_up{region=~\"$region\", target=~\"$target\"}) == 0) or vector(0)",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Targets that are down from at least one selected region. The TargetDown alert pages only when every region agrees."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "avg(avg_over_time(pulsewatch_up{region=~\"$region\", target=~\"$target\"}[$__range]))",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Current status",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "pulsewatch_up{region=~\"$region\", target=~\"$target\"}",
          "range": false,
          "instant": true,
          "legendFormat": "{{target}} · {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical"
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "Up/down history",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "pulsewatch_up{region=~\"$region\", target=~\"$target\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{target}} · {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "pulsewatch:latency_p95_seconds{region=~\"$region\", target=~\"$target\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{target}} · {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Latency p50",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, target, region) (rate(pulsewatch_probe_latency_seconds_bucket{region=~\"$region\", target=~\"$target\"}[5m])))",
          "range": true,
          "instant": false,
          "legendFormat": "{{target}} · {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Uptime (last 1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "pulsewatch:uptime_ratio_1h{region=~\"$region\", target=~\"$target\"}",
          "range": false,
          "instant": true,
          "legendFormat": "{{target}} · {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failed probes per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "sum by (target, region) (rate(pulsewatch_probes_total{region=~\"$region\", target=~\"$target\", result=\"down\"}[5m])) * 60",
          "range": true,
          "instant": false,
          "legendFormat": "{{target}} · {{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Firing alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", alertname=~\"Target.*|ErrorBudget.*|Probe.*\", region=~\"$region|\", target=~\"$target|\"}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true
            },
            "renameByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Error budget left (7d SLO, all regions)",
      "description": "Share of the 7-day error budget still unspent. Budget = (1 - slo_objective) of the week. Down means down from every region, so a single bad probe location spends nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "pulsewatch:slo_error_budget_remaining:7d{target=~\"$target\"}",
          "range": false,
          "instant": true,
          "legendFormat": "{{target}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Availability vs objective (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "1 - pulsewatch:slo_error_ratio:7d{target=~\"$target\"}",
          "range": false,
          "instant": true,
          "legendFormat": "{{target}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "B",
          "expr": "pulsewatch:slo_objective{target=~\"$target\"}",
          "range": false,
          "instant": true,
          "legendFormat": "{{target}}"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "target": "Target",
              "Value #A": "Availability (7d)",
              "Value #B": "Objective"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Burn rate (1 = budget lasts exactly 7d)",
      "description": "ErrorBudgetBurnFast pages above 14.4 on both 1h and 5m. ErrorBudgetBurnSlow warns above 6 on 6h and 30m.",
      "datasource": {
        "type": "prometheus",
        "uid": "pulsewatch-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "A",
          "expr": "pulsewatch:slo_burn_rate:1h{target=~\"$target\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{target}} · 1h"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pulsewatch-prometheus"
          },
          "refId": "B",
          "expr": "pulsewatch:slo_burn_rate:6h{target=~\"$target\"}",
          "range": true,
          "instant": false,
          "legendFormat": "{{target}} · 6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
